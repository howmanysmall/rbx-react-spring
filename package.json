{
	"name": "@rbxts/react-spring",
	"version": "2.0.0-ts.2",
	"description": "A modern spring-physics based animation library for React Luau inspired by react-spring",
	"keywords": ["roblox", "react", "react-luau", "react-spring", "spring", "animation", "ui", "ux", "hooks"],
	"license": "MIT",
	"author": "chriscerie",
	"contributors": ["HowManySmall"],
	"type": "module",
	"main": "src/init.luau",
	"types": "src/index.d.ts",
	"files": [
		"!**/*.tsbuildinfo",
		"src",
		"*.luau",
		"!wally.toml",
		"!wally.lock",
		"!default.project.json",
		"!**/__tests__"
	],
	"scripts": {
		"build": "rbxtsc",
		"lint:biome": "bun x biome ci ./src",
		"lint:eslint": "bun x --bun eslint --max-warnings=0 --cache -c eslint.config.ts ./src",
		"prepublishOnly": "bun run build",
		"watch": "rbxtsc -w"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.6",
		"@eslint-react/eslint-plugin": "1.53.1",
		"@eslint/config-inspector": "^1.3.0",
		"@isentinel/eslint-config": "^3.2.2",
		"@isentinel/tsconfig": "^1.0.0",
		"@rbxts/compiler-types": "3.0.0-types.0",
		"@rbxts/types": "^1.0.886",
		"@types/bun": "latest",
		"arktype": "^2.1.23",
		"eslint": "^9.36.0",
		"eslint-import-resolver-typescript": "^4.4.4",
		"eslint-plugin-import-x": "^4.16.1",
		"eslint-plugin-jest": "29.0.1",
		"eslint-plugin-perfectionist": "^4.15.0",
		"eslint-plugin-react-roblox-hooks": "^5.1.0-rbx.1",
		"jiti": "^2.4.2",
		"roblox-ts": "^3.0.0",
		"typescript": "5.5.3"
	},
	"peerDependencies": {
		"@rbxts/react": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
