{
	"name": "@rbxts/react-spring",
	"version": "2.0.0-ts.1",
	"description": "A modern spring-physics based animation library for React Luau inspired by react-spring",
	"main": "src/init.luau",
	"types": "src/index.d.ts",
	"scripts": {
		"build": "rbxtsc",
		"lint:biome": "bun x biome ci ./src",
		"lint:eslint": "bun x --bun eslint --max-warnings=0 --cache -c eslint.config.ts ./src",
		"prepublishOnly": "bun run build",
		"watch": "rbxtsc -w"
	},
	"keywords": ["roblox", "react", "react-luau", "react-spring", "spring", "animation", "ui", "ux", "hooks"],
	"author": "chriscerie",
	"contributors": ["HowManySmall"],
	"license": "MIT",
	"files": [
		"!**/*.tsbuildinfo",
		"src",
		"*.luau",
		"!wally.toml",
		"!wally.lock",
		"!default.project.json",
		"!**/__tests__"
	],
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.6",
		"@eslint-react/eslint-plugin": "^2.0.1",
		"@eslint/config-inspector": "^1.1.0",
		"@isentinel/eslint-config": "^3.0.0-beta.7",
		"@rbxts/compiler-types": "3.0.0-types.0",
		"@rbxts/types": "^1.0.886",
		"eslint": "9.36.0",
		"eslint-config-biome": "^2.1.3",
		"eslint-plugin-jest": "29.0.1",
		"eslint-plugin-perfectionist": "^4.15.0",
		"eslint-plugin-react-roblox-hooks": "^5.1.0-rbx.1",
		"jiti": "^2.4.2",
		"roblox-ts": "^3.0.0",
		"typescript": "5.5.3"
	},
	"peerDependencies": {
		"@rbxts/react": "*"
	}
}
